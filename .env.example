# Copy this file to `.env` for local runs, Docker, VPS, or any platform that
# accepts an environment file. Platform dashboards (Heroku, Northflank, Koyeb,
# Hugging Face, Google Cloud) take the same keys as variables/secrets.
# Real environment variables always override values declared here.

# --- Required ---------------------------------------------------------------
APP_ID=12345678
API_HASH=your_api_hash_here
TG_BOT_TOKEN=1234567890:your_bot_token_here
BOT_USERNAME=YourBotUsername
AUTH_USERS=123456789 -1001234567890
LOG_CHANNEL=@YourLogChannel
# Optional. Every finished upload (video/files) is copied here as well.
# Leave empty to switch the dump off. Bot must be admin in this chat.
DUMP_CHANNEL=
DB_URL=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
DB_NAME=enc

# --- Optional ---------------------------------------------------------------
SESSION_NAME=AHCompressorBot
UPDATES_CHANNEL=NexonBots
# USER_SESSION_STRING=
# STRING_API_ID=12345678
# STRING_API_HASH=
# SESSION_USER_ID=0
# PICS=https://i.ibb.co/wrdKRrzs/x.jpg

# /update — repository to pull from and a PAT for private repos
UPSTREAM_REPO=PrimeSujoy/VideoUtil
GIT_TOKEN=

# Bot owner Telegram ID (auto-added to AUTH_USERS + owner-only Drive controls)
OWNER_ID=0

# --- Google Drive (optional - Settings > Google Drive) ------------------------
# Google Cloud OAuth client, type "Desktop app". Never commit real values.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_PROJECT_ID=
# Loopback callback - lets users connect without pasting any code
GDRIVE_REDIRECT_URI=http://localhost:8080/oauth2callback
# Public index page in front of your Drive folder (used for mirror links)
INDEX_URL=

# Health-check server port (container image defaults to 7860)
# PORT=7860

# Runtime work directory (Docker image defaults to /data)
# WORK_DIR=/data
